{
  "id": "microlendar-description-hawaii-absolute-active",
  "environment": "microlendar",
  "start_page": "HOST_ADDRESS/microlendar",
  "prompt": "I'm expecting a calendar invite about a trip to Hawaii -- the details should be in the event description, so you'll need to open each event to check.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_events",
      "payload": {
        "event_ids": [
          "evt001",
          "evt002",
          "evt003",
          "evt004",
          "evt005"
        ],
        "task_ids": [
          "task01",
          "task02"
        ]
      }
    },
    {
      "time": 80,
      "type": "new_event",
      "payload": {
        "event_id": "evt008"
      }
    },
    {
      "time": 160,
      "type": "new_event",
      "payload": {
        "event_id": "evt010"
      }
    },
    {
      "time": 240,
      "type": "new_event",
      "payload": {
        "event_id": "evt011"
      }
    },
    {
      "time": 300,
      "type": "new_event",
      "payload": {
        "event_id": "evt013"
      }
    },
    {
      "time": 450,
      "type": "new_event",
      "payload": {
        "event_id": "evt014"
      }
    },
    {
      "time": 600,
      "type": "new_event",
      "payload": {
        "event_id": "evt016"
      }
    }
  ],
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "absolute",
    "event_persistence": "persistent",
    "monitoring_approach": "active",
    "difficulty": "hard",
    "distraction_level": "medium"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM events e JOIN event_states s ON e.id=s.event_id WHERE s.deleted=0 AND e.is_task=0 AND e.description LIKE '%Hawaii%') >= 1"
}
