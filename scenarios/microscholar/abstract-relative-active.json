{
  "id": "microscholar-abstract-relative-active",
  "environment": "microscholar",
  "start_page": "HOST_ADDRESS/microscholar",
  "prompt": "I'm tracking papers that mention 'unstructured environments' in their abstract -- there's already one in the results, so let me know when 2 more show up.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_papers",
      "payload": {
        "paper_ids": [
          "paper-071",
          "paper-091",
          "paper-092",
          "paper-093",
          "paper-094",
          "paper-095",
          "paper-096"
        ],
        "alert_ids": []
      }
    },
    {
      "time": 70,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-097"
      }
    },
    {
      "time": 150,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-072"
      }
    },
    {
      "time": 230,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-098"
      }
    },
    {
      "time": 300,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-073"
      }
    },
    {
      "time": 420,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-074"
      }
    },
    {
      "time": 550,
      "type": "new_paper",
      "payload": {
        "paper_id": "paper-081"
      }
    }
  ],
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "active",
    "difficulty": "hard",
    "distraction_level": "medium"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM papers WHERE LOWER(snippet) LIKE '%unstructured environments%') >= 3"
}
