{
  "id": "microhood-portfolio-relative-passive",
  "environment": "microhood",
  "start_page": "HOST_ADDRESS/microhood",
  "prompt": "Watch my portfolio value and let me know when it's up 5% from where it started.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_stocks",
      "payload": {
        "stock_symbols": [
          "*"
        ],
        "watchlist_symbols": [
          "*"
        ],
        "news_ids": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ],
        "buying_power": 10000.0
      }
    },
    {
      "time": 60,
      "type": "new_news",
      "payload": {
        "news_id": "11"
      }
    },
    {
      "time": 150,
      "type": "new_news",
      "payload": {
        "news_id": "14"
      }
    },
    {
      "time": 400,
      "type": "new_news",
      "payload": {
        "news_id": "17"
      }
    },
    {
      "time": 550,
      "type": "new_news",
      "payload": {
        "news_id": "20"
      }
    }
  ],
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT (SELECT CAST(value AS REAL) FROM session_meta WHERE key='buying_power') + COALESCE((SELECT SUM(ss.shares * cp.price) FROM stock_states ss JOIN current_prices cp ON ss.symbol=cp.symbol), 0) >= CAST((SELECT value FROM session_meta WHERE key='baseline_portfolio_value') AS REAL) * 1.05"
}
