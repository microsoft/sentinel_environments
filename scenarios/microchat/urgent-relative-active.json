{
  "id": "microchat-urgent-relative-active",
  "environment": "microchat",
  "start_page": "HOST_ADDRESS/microchat",
  "prompt": "I've already got a couple of urgent pings this morning. Let me know when at least 3 more urgent messages arrive. Note: urgent messages are only marked as such inside the conversation, not in the sidebar.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_messages",
      "payload": {
        "message_ids": [
          "urg-dm-03", "urg-grp-03",
          "dm-03", "dm-11", "dm-33",
          "grp-04", "grp-08", "mtg-03"
        ]
      }
    },
    {
      "time": 80,
      "type": "new_message",
      "payload": { "message_id": "dm-38" }
    },
    {
      "time": 145,
      "type": "new_message",
      "payload": { "message_id": "urg-dm-04" }
    },
    {
      "time": 215,
      "type": "new_message",
      "payload": { "message_id": "grp-26" }
    },
    {
      "time": 265,
      "type": "new_message",
      "payload": { "message_id": "urg-grp-05" }
    },
    {
      "time": 300,
      "type": "new_message",
      "payload": { "message_id": "urg-dm-05" }
    },
    {
      "time": 380,
      "type": "new_message",
      "payload": { "message_id": "urg-dm-06" }
    },
    {
      "time": 460,
      "type": "new_message",
      "payload": { "message_id": "grp-46" }
    },
    {
      "time": 540,
      "type": "new_message",
      "payload": { "message_id": "mtg-22" }
    }
  ],
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "active",
    "difficulty": "hard",
    "distraction_level": "medium"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM messages WHERE isUrgent = 1) >= (SELECT CAST(value AS INTEGER) FROM session_meta WHERE key = 'baseline_urgent_total') + 3"
}
