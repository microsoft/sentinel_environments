{
  "id": "microhub-body-compliance-absolute-active",
  "environment": "microhub",
  "start_page": "HOST_ADDRESS/microhub",
  "prompt": "Watch for new issues. If one comes in that mentions compliance in its description, leave a comment on it and let me know.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_repo",
      "payload": {
        "issue_ids": ["i8", "i12", "i15"]
      }
    },
    {
      "time": 80,
      "type": "new_issue",
      "payload": {
        "issue_id": "i16"
      }
    },
    {
      "time": 170,
      "type": "new_issue",
      "payload": {
        "issue_id": "i17"
      }
    },
    {
      "time": 250,
      "type": "new_issue",
      "payload": {
        "issue_id": "i18"
      }
    },
    {
      "time": 300,
      "type": "new_issue",
      "payload": {
        "issue_id": "i20"
      }
    },
    {
      "time": 400,
      "type": "new_issue",
      "payload": {
        "issue_id": "i19"
      }
    }
  ],
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "absolute",
    "event_persistence": "persistent",
    "monitoring_approach": "active",
    "difficulty": "medium",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT EXISTS(SELECT 1 FROM user_created_comments WHERE target_type='issue' AND target_id='i20')"
}
