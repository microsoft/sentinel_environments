{
  "id": "microhub-stars-absolute-passive",
  "environment": "microhub",
  "start_page": "HOST_ADDRESS/microhub",
  "prompt": "Watch the star count on this repo and let me know when it hits 2,000.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_repo",
      "payload": {
        "issue_ids": ["i8", "i12"],
        "star_waypoints": [[0, 1847], [300, 2000], [600, 2080]]
      }
    },
    {
      "time": 100,
      "type": "new_issue",
      "payload": {
        "issue_id": "i15"
      }
    },
    {
      "time": 200,
      "type": "new_issue",
      "payload": {
        "issue_id": "i16"
      }
    },
    {
      "time": 400,
      "type": "new_issue",
      "payload": {
        "issue_id": "i18"
      }
    },
    {
      "time": 550,
      "type": "new_issue",
      "payload": {
        "issue_id": "i19"
      }
    }
  ],
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "absolute",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT CAST((SELECT value FROM repo_flags WHERE key='star_count') AS INTEGER) >= 2000"
}
