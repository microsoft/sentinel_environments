{
  "id": "microhub-issues-relative-passive",
  "environment": "microhub",
  "start_page": "HOST_ADDRESS/microhub",
  "prompt": "I already have a few open issues. Let me know when 4 more get filed.",
  "condition_at": 300,
  "duration": 600,
  "events": [
    {
      "time": 0,
      "type": "preload_repo",
      "payload": {
        "issue_ids": ["i8", "i12", "i15"]
      }
    },
    {
      "time": 60,
      "type": "new_issue",
      "payload": {
        "issue_id": "i16"
      }
    },
    {
      "time": 140,
      "type": "new_issue",
      "payload": {
        "issue_id": "i17"
      }
    },
    {
      "time": 220,
      "type": "new_issue",
      "payload": {
        "issue_id": "i18"
      }
    },
    {
      "time": 300,
      "type": "new_issue",
      "payload": {
        "issue_id": "i19"
      }
    },
    {
      "time": 400,
      "type": "new_issue",
      "payload": {
        "issue_id": "i20"
      }
    },
    {
      "time": 550,
      "type": "stars_waypoint",
      "payload": {
        "delta": 10
      }
    }
  ],
  "taxonomy": {
    "criteria": "objective",
    "milestone_type": "relative",
    "event_persistence": "persistent",
    "monitoring_approach": "passive",
    "difficulty": "easy",
    "distraction_level": "low"
  },
  "eval_sql": "SELECT (SELECT COUNT(*) FROM issues) >= CAST((SELECT value FROM session_meta WHERE key='baseline_issue_count') AS INTEGER) + 4"
}
